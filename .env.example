# Clerk Authentication Keys
# Obtenlas desde https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_TU_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_TU_SECRET_KEY

# Rutas de autenticación
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin

# Lista blanca de emails de administradores autorizados (separados por coma)
# Si está vacío, cualquier usuario autenticado en tu Clerk puede acceder al admin.
# Si indicas emails, solo los que coincidan podrán acceder.
ADMIN_EMAILS=

# Base de datos Supabase (PostgreSQL con Prisma ORM)
# Obtenlas en Supabase -> Project Settings -> Database -> Connection string:
#
# 1. Modo Pooler (Transaction / PgBouncer, puerto 6543) para Server Actions:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# 2. Modo Directo (Direct connection, puerto 5432) para migraciones y prisma db push:
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

